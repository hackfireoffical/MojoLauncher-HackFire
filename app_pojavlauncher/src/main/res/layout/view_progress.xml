<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:background="@drawable/bg_task_menu"
        android:elevation="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/progress_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="↓"
                android:textSize="22sp"
                android:textColor="#82DCEB"
                android:background="@drawable/bg_task_icon" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Menu"
                    android:textColor="@color/primary_text"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/progress_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No active tasks"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/progress_flip_arrow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⌃"
                android:textColor="@color/secondary_text"
                android:textSize="20sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/progress_scroll"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/progress_linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
